{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/api/handler"
    }
  ],
  "functions": {
    "api/handler.js": {
      "maxDuration": 60
    }
  }
}
